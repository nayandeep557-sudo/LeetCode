        }
        return res;
    }
}
class SparseTableValueMax {
    int[][] st;
    int[] log;
    public SparseTableValueMax(int[] val) {
        int n = val.length;
        if (n == 0) return;
        log = new int[n + 1];
        for (int i = 2; i <= n; i++) log[i] = log[i / 2] + 1;
        int maxLog = log[n] + 1;
        st = new int[maxLog][n];
        for (int i = 0; i < n; i++) st[0][i] = val[i];
        for (int j = 1; j < maxLog; j++) {
            for (int i = 0; i + (1 << j) <= n; i++) {
                st[j][i] = Math.max(st[j - 1][i], st[j - 1][i + (1 << (j - 1))]);
            }
        }
    }
    public int queryMax(int L, int R) {
        int j = log[R - L + 1];
        return Math.max(st[j][L], st[j][R - (1 << j) + 1]);
    }
}
