class Solution {
    public String lexGreaterPermutation(String s, String target) {
        int n = s.length();
        int[] freq = new int[26];
        for (char c : s.toCharArray()) {
            freq[c - 'a']++;
        }
        boolean[] possible = new boolean[n + 1];
        possible[0] = true;
        int[] remaining = freq.clone();
        for (int i = 0; i < n; i++) {
            int ch = target.charAt(i) - 'a';
            if (possible[i] && remaining[ch] > 0) {
                possible[i + 1] = true;
                remaining[ch]--;
            } else {
                possible[i + 1] = false;
            }
        }
        for (int i = n - 1; i >= 0; i--) {
            if (!possible[i]) {
                continue;
            }
            int[] count = freq.clone();
            boolean valid = true;
            for (int j = 0; j < i; j++) {
                int ch = target.charAt(j) - 'a';
                if (count[ch] == 0) {
                    valid = false;
                    break;
                }
                count[ch]--;
            }
            if (!valid) {
                continue;
            }
            int current = target.charAt(i) - 'a';
            for (int ch = current + 1; ch < 26; ch++) {
                if (count[ch] > 0) {
                    StringBuilder ans = new StringBuilder();
                    ans.append(target, 0, i);
                    ans.append((char) ('a' + ch));
                    count[ch]--;
                    for (int c = 0; c < 26; c++) {
                        while (count[c] > 0) {
                            ans.append((char) ('a' + c));
                            count[c]--;
                        }
                    }
                    return ans.toString();
                }
            }
        }
        return "";
    }
}
