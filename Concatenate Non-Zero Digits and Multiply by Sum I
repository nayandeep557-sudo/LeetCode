class Solution {
    public long sumAndMultiply(int n) {
        if (n == 0) return 0;

        long x = 0;
        long sum = 0;

        char[] digits = String.valueOf(n).toCharArray();

        for (char c : digits) {
            if (c != '0') {
                int d = c - '0';
                x = x * 10 + d;
                sum += d;
            }
        }

        return x * sum;
    }
}
