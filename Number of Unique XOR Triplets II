class Solution {
    public int uniqueXorTriplets(int[] nums) {
        final int MAX = 2048;
        boolean[][] dp = new boolean[4][MAX];
        dp[0][0] = true;
        for (int x : nums) {
            for (int k = 2; k >= 0; k--) {
                for (int v = 0; v < MAX; v++) {
                    if (dp[k][v]) {
                        dp[k + 1][v ^ x] = true;
                    }
                }
            }
        }
        boolean[] seen = new boolean[MAX];
        for (int x : nums) {
            seen[x] = true;
        }
        for (int v = 0; v < MAX; v++) {
            if (dp[3][v]) {
                seen[v] = true;
            }
        }
        int ans = 0;
        for (boolean b : seen) {
            if (b) ans++;
        }
        return ans;
    }
}
